# Mac control-plane configuration. The SQLite database must be local, not SMB,
# iCloud, or another synchronized directory.
DMM_DATABASE_PATH=/path/to/local/dmm.sqlite3
DMM_OMV_ROOT=/path/to/omv-media
# Local cache for thumbnails and proxies; keep outside the OMV and synced roots.
DMM_DERIVATIVES_ROOT=/path/to/local/derivatives
DMM_BIND_HOST=127.0.0.1
DMM_PORT=8000
DMM_ALLOW_INSECURE_LAN=false
# Configure both paths to enable TLS for a LAN bind, or leave both blank.
DMM_TLS_CERTFILE=
DMM_TLS_KEYFILE=
# Paths are a JSON array because this is consumed by pydantic-settings.
DMM_SYNCED_ROOTS=["/path/to/synchronized-directory"]
# Replace before use; this value must contain at least 32 characters.
DMM_WORKER_BOOTSTRAP_TOKEN=replace-with-a-random-token-of-at-least-32-characters

# Windows worker configuration.
DMM_SERVER_URL=https://mac-control-plane.local:8443
DMM_WORKER_NAME=windows-laptop
DMM_POLL_SECONDS=10
DMM_HEARTBEAT_SECONDS=30
